{
  "name": "@johnshandux/ledger-design-system",
  "version": "1.2.0",
  "files": [
    "dist"
  ],
  "description": "The shared tokens, components, patterns and guidance for LedgerOS and Ledger Bank",
  "scripts": {
    "test": "vitest run --config vitest.unit.config.ts",
    "test:data-table": "vitest run --config vitest.unit.config.ts src/components/DataTable",
    "typecheck": "../../node_modules/.bin/tsc --noEmit",
    "test:storybook": "vitest run --project storybook",
    "test:theme-parity": "node --test src/themes/dark.parity.test.mjs",
    "test:theme-artifact": "node --test src/themes/theme-artifact.test.mjs",
    "test:status-icon-colors": "node --test src/themes/status-icon-colors.test.mjs",
    "test:control-colors": "node --test src/themes/control-colors.test.mjs",
    "test:table-colors": "node --test src/themes/table-colors.test.mjs",
    "test:typography": "node --test src/tokens/typography.test.mjs",
    "test:data-table-boundary": "node --test src/data-table-boundary.test.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "vite build && node scripts/verify-package-exports.mjs && npm run test && npm run test:theme-artifact && npm run test:status-icon-colors && npm run test:control-colors && npm run test:table-colors && npm run test:typography && npm run test:data-table-boundary"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnshandUX/ledger.git",
    "directory": "packages/design-system"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "bugs": {
    "url": "https://github.com/johnshandUX/ledger/issues"
  },
  "homepage": "https://github.com/johnshandUX/ledger/tree/main/packages/design-system#readme",
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "playwright": "latest",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^4.1.11"
  },
  "main": "./dist/ledger-design-system.js",
  "module": "./dist/ledger-design-system.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ledger-design-system.js",
