      "require": "./dist/appearance-toggle.cjs",
      "default": "./dist/appearance-toggle.js"
    },
    "./data-table": {
      "types": "./dist/data-table.d.ts",
      "import": "./dist/data-table.js",
      "require": "./dist/data-table.cjs",
      "default": "./dist/data-table.js"
    },
    "./docs": {
      "types": "./dist/docs.d.ts",
      "import": "./dist/docs.js",
